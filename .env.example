# Copy to .env and fill in. Never commit .env.

# Claude (identification, pricing analysis, descriptions)
ANTHROPIC_API_KEY=

# Cloudflare R2 (R2 > Manage API tokens > Create token with Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# eBay developer app keyset (production) for Browse API active-listing comps.
# https://developer.ebay.com/my/keys  - only the client-credentials grant is used.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Shared secret for the web UI. Required whenever the server is reachable
# beyond localhost (phone on Wi-Fi, Cloudflare Tunnel). Open
# http://<host>:8765/?token=<value> once on each device to set the cookie.
LISTER_ACCESS_TOKEN=
# Seller consent for API publishing: set EBAY_RUNAME, then run `python -m lister ebay-login`.
EBAY_RUNAME=
EBAY_REFRESH_TOKEN=
